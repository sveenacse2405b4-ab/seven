const {Builder, By} = require("selenium-webdriver");

async function test() {
    let driver = await new Builder().forBrowser("chrome").build();

    await driver.get(require("url").pathToFileURL(require("path").resolve("index.html")).href);

    await driver.findElement(By.id("a")).sendKeys("10");
    await driver.findElement(By.id("b")).sendKeys("20");
    await driver.findElement(By.id("add")).click();

    console.log(await driver.findElement(By.id("result")).getText());

    await driver.quit();
}

test();
